---
import InteriorLayout from '../layouts/InteriorLayout.astro';

const pageTitle = 'Terms of Service | QUAVAR Facility Services';
const pageDescription =
  'Terms of Service for QUAVAR Facility Services, including website use, business communications, email, and SMS messaging terms.';
---

<InteriorLayout title={pageTitle} description={pageDescription}>
  <main class="legal-page">
    <section class="legal-hero">
      <div class="container legal-hero__content">
        <p class="eyebrow">Legal</p>
        <h1>Terms of Service</h1>

        <p class="legal-hero__intro">
          These Terms of Service govern your use of the QUAVAR Facility Services
          website and certain communications and interactions with QUAVAR,
          including email and SMS communications.
        </p>

        <p class="legal-effective">Effective Date: October 5, 2026</p>
      </div>
    </section>

    <section class="legal-content section">
      <div class="container legal-content__grid">
        <aside class="legal-sidebar">
          <p class="legal-sidebar__label">QUAVAR Facility Services</p>

          <p>
            Restrepo Jaramillo Brothers Investment Group LLC<br />
            doing business as QUAVAR Facility Services
          </p>

          <p>
            4001 W Obispo St<br />
            Tampa, FL 33629<br />
            United States
          </p>

          <p>
            <a href="mailto:sales@quavarfs.com">sales@quavarfs.com</a>
          </p>
        </aside>

        <article class="legal-copy">
          <section>
            <h2>1. Acceptance of These Terms</h2>

            <p>
              These Terms of Service ("Terms") apply to the website, communications,
              and related services provided by Restrepo Jaramillo Brothers Investment
              Group LLC, doing business as QUAVAR Facility Services ("QUAVAR,"
              "we," "us," or "our").
            </p>

            <p>
              By accessing or using our website, submitting information to us, or
              otherwise interacting with QUAVAR through our website or
              communications, you agree to these Terms to the extent applicable to
              your interaction with us.
            </p>
          </section>

          <section>
            <h2>2. About QUAVAR Facility Services</h2>

            <p>
              QUAVAR Facility Services provides commercial facility cleaning and
              related facility services. Information presented on our website is
              intended to provide general information about our company,
              capabilities, service approach, and available services.
            </p>

            <p>
              Website content does not constitute a binding proposal, service
              agreement, guarantee, or commitment to perform services. Specific
              services, pricing, schedules, scopes of work, and other commercial
              terms may be governed by separate proposals, statements of work,
              contracts, or other written agreements.
            </p>
          </section>

          <section>
            <h2>3. Website Use</h2>

            <p>
              You may use this website for lawful purposes and to learn about,
              inquire about, or communicate with QUAVAR regarding our services and
              business activities.
            </p>

            <p>You agree not to:</p>

            <ul>
              <li>Use the website for unlawful, fraudulent, or abusive purposes.</li>
              <li>Attempt to interfere with the operation or security of the website.</li>
              <li>Attempt to gain unauthorized access to systems, accounts, or data.</li>
              <li>Transmit malicious code or intentionally harmful material.</li>
              <li>
                Use automated means to access the website in a manner that
                materially disrupts or burdens its operation.
              </li>
            </ul>
          </section>

          <section>
            <h2>4. Requests for Information and Proposals</h2>

            <p>
              You may contact QUAVAR to request information, discuss facility
              requirements, schedule a walkthrough, or request a proposal or quote.
            </p>

            <p>
              Submitting an inquiry does not create a customer relationship,
              obligate QUAVAR to provide services, or constitute acceptance of any
              proposed scope, price, schedule, or other commercial term.
            </p>

            <p>
              Any binding service relationship will be subject to the applicable
              written agreement, proposal, statement of work, or other documentation
              accepted by the relevant parties.
            </p>
          </section>

          <section>
            <h2>5. Email Communications</h2>

            <p>
              By communicating with QUAVAR by email or providing your email address
              in connection with a business inquiry or relationship, you may receive
              communications relating to your inquiry, requested services,
              walkthroughs, proposals, quotes, scheduling, account matters, or
              ongoing business communications.
            </p>

            <p>
              Where permitted by applicable law, QUAVAR may also send marketing or
              promotional email communications. Marketing recipients may opt out of
              future promotional emails by using the unsubscribe mechanism provided
              in the message or by contacting
              <a href="mailto:sales@quavarfs.com">sales@quavarfs.com</a>.
            </p>

            <p>
              Opting out of promotional emails does not necessarily prevent us from
              sending communications that are operational, transactional, requested,
              or otherwise related to an existing business relationship.
            </p>
          </section>

          <section>
            <h2>6. SMS and Text Messaging Terms</h2>

            <p>
              QUAVAR may send SMS or text messages only to individuals who have
              provided consent to receive text communications from us.
            </p>

            <p>
              Our SMS communications are intended primarily for individual business
              follow-up and may relate to inquiries, facility cleaning services,
              walkthrough scheduling, proposals, quotes, and ongoing business
              communications.
            </p>

            <p>
              <strong>
                Consent to receive SMS messages is not a condition of purchasing
                goods or services from QUAVAR.
              </strong>
            </p>

            <h3>Message Frequency</h3>

            <p>
              Message frequency varies based on your interactions with QUAVAR
              Facility Services.
            </p>

            <h3>Message and Data Rates</h3>

            <p>
              Message and data rates may apply depending on your mobile carrier and
              service plan.
            </p>

            <h3>Opt-Out</h3>

            <p>
              You may opt out of receiving SMS messages from QUAVAR at any time by
              replying <strong>STOP</strong> to a message from us. After an opt-out
              request, we will stop sending SMS messages to that number unless you
              subsequently provide new consent to receive them.
            </p>

            <h3>Help</h3>

            <p>
              For assistance regarding SMS communications, reply
              <strong>HELP</strong> or contact QUAVAR at
              <a href="mailto:sales@quavarfs.com">sales@quavarfs.com</a>.
            </p>

            <h3>Carrier Disclaimer</h3>

            <p>
              Mobile carriers are not liable for delayed or undelivered messages.
              Message delivery is subject to the availability and operation of
              wireless networks and services outside QUAVAR's control.
            </p>

            <h3>Privacy</h3>

            <p>
              Our collection and handling of information associated with SMS
              communications is described in our
              <a href="/privacy-policy">Privacy Policy</a>. SMS opt-in data and
              consent are not sold or shared with third parties or affiliates for
              their own marketing or promotional purposes.
            </p>
          </section>

          <section>
            <h2>7. Communication Preferences</h2>

            <p>
              QUAVAR respects communication preferences and opt-out requests. If you
              request that we stop sending a particular category of marketing
              communication, we will take reasonable steps to honor that request.
            </p>

            <p>
              Certain non-marketing communications may still be sent when reasonably
              necessary to respond to a request, administer an existing business
              relationship, provide requested services, comply with legal
              obligations, or address operational or security matters.
            </p>
          </section>

          <section>
            <h2>8. Intellectual Property</h2>

            <p>
              Unless otherwise indicated, the QUAVAR name, branding, website
              design, text, graphics, and other original website content are owned
              by or licensed to QUAVAR and are protected by applicable intellectual
              property laws.
            </p>

            <p>
              You may view and use website content for ordinary informational and
              business purposes. You may not reproduce, distribute, modify,
              republish, or commercially exploit protected website content without
              appropriate authorization.
            </p>
          </section>

          <section>
            <h2>9. Third-Party Services and Links</h2>

            <p>
              Our website may contain links to third-party websites, platforms, or
              services. These third parties operate independently from QUAVAR.
            </p>

            <p>
              We are not responsible for the availability, content, security,
              privacy practices, or terms of third-party websites or services.
              Access to third-party resources is at your discretion and may be
              subject to separate terms and policies.
            </p>
          </section>

          <section>
            <h2>10. Website Information and Availability</h2>

            <p>
              We seek to provide accurate and useful information, but website
              content may contain errors, omissions, or information that becomes
              outdated. We may modify website content, features, or availability at
              any time.
            </p>

            <p>
              To the extent permitted by applicable law, the website is provided on
              an "as is" and "as available" basis without warranties regarding
              uninterrupted availability or freedom from errors.
            </p>
          </section>

          <section>
            <h2>11. Limitation of Liability</h2>

            <p>
              To the maximum extent permitted by applicable law, QUAVAR and its
              owners, officers, employees, representatives, and service providers
              will not be liable for indirect, incidental, special, consequential,
              or punitive damages arising solely from your use of, or inability to
              use, this website.
            </p>

            <p>
              Nothing in these Terms is intended to exclude or limit liability that
              cannot lawfully be excluded or limited.
            </p>
          </section>

          <section>
            <h2>12. Privacy</h2>

            <p>
              Your use of the website and communications with QUAVAR may involve the
              collection and processing of personal information. Please review our
              <a href="/privacy-policy">Privacy Policy</a> for information about our
              privacy practices.
            </p>
          </section>

          <section>
            <h2>13. Governing Law</h2>

            <p>
              These Terms are governed by the laws of the State of Florida, without
              regard to conflict-of-law principles, except where applicable federal
              law or another mandatory legal requirement provides otherwise.
            </p>
          </section>

          <section>
            <h2>14. Changes to These Terms</h2>

            <p>
              We may update these Terms periodically to reflect changes in our
              website, services, communications practices, business operations, or
              legal requirements. When changes are made, we may update the effective
              date shown at the top of this page.
            </p>
          </section>

          <section>
            <h2>15. Contact Us</h2>

            <p>
              Questions regarding these Terms or QUAVAR communications may be
              directed to:
            </p>

            <address>
              <strong>QUAVAR Facility Services</strong><br />
              Restrepo Jaramillo Brothers Investment Group LLC<br />
              4001 W Obispo St<br />
              Tampa, FL 33629<br />
              United States<br />
              <a href="mailto:sales@quavarfs.com">sales@quavarfs.com</a>
            </address>
          </section>
        </article>
      </div>
    </section>
  </main>
</InteriorLayout>

<style>
  .legal-page {
    background: var(--color-white);
  }

  .legal-hero {
    padding: clamp(112px, 14vw, 168px) 0 clamp(72px, 9vw, 104px);
    background: var(--color-navy);
  }

  .legal-hero__content {
    max-width: 900px;
  }

  .legal-hero .eyebrow {
    color: var(--color-teal);
  }

  .legal-hero h1 {
    margin-top: 22px;
    color: var(--color-white);
  }

  .legal-hero__intro {
    max-width: 760px;
    margin-top: 28px;
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.65;
  }

  .legal-effective {
    margin-top: 30px;
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .legal-content__grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.32fr) minmax(0, 1fr);
    gap: clamp(48px, 8vw, 112px);
    align-items: start;
  }

  .legal-sidebar {
    position: sticky;
    top: 120px;
    padding: 32px;
    background: var(--color-off-white);
    border: 1px solid var(--color-border);
  }

  .legal-sidebar__label {
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .legal-sidebar p {
    margin: 0 0 22px;
    color: var(--color-slate);
    line-height: 1.65;
  }

  .legal-sidebar p:last-child {
    margin-bottom: 0;
  }

  .legal-sidebar a,
  .legal-copy a {
    color: var(--color-navy);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-copy {
    max-width: 820px;
  }

  .legal-copy section {
    padding-bottom: 42px;
    margin-bottom: 42px;
    border-bottom: 1px solid var(--color-border);
  }

  .legal-copy section:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: 0;
  }

  .legal-copy h2 {
    margin-bottom: 20px;
    color: var(--color-navy);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
  }

  .legal-copy h3 {
    margin: 28px 0 12px;
    color: var(--color-navy);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .legal-copy p,
  .legal-copy li,
  .legal-copy address {
    color: var(--color-slate);
    font-size: 1rem;
    line-height: 1.8;
  }

  .legal-copy p {
    margin: 0 0 18px;
  }

  .legal-copy p:last-child {
    margin-bottom: 0;
  }

  .legal-copy ul {
    display: grid;
    gap: 10px;
    margin: 18px 0 0;
    padding-left: 24px;
  }

  .legal-copy address {
    margin-top: 20px;
    font-style: normal;
  }

  @media (max-width: 900px) {
    .legal-content__grid {
      grid-template-columns: 1fr;
    }

    .legal-sidebar {
      position: static;
      max-width: 520px;
    }
  }

  @media (max-width: 640px) {
    .legal-hero {
      padding: 96px 0 68px;
    }

    .legal-sidebar {
      padding: 26px;
    }

    .legal-copy section {
      padding-bottom: 34px;
      margin-bottom: 34px;
    }
  }
</style>