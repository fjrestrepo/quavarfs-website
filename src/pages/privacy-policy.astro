---
import InteriorLayout from '../layouts/InteriorLayout.astro';

const pageTitle = 'Privacy Policy | QUAVAR Facility Services';
const pageDescription =
  'Privacy Policy for QUAVAR Facility Services, including information about personal data, communications, email, and SMS messaging practices.';
---

<InteriorLayout title={pageTitle} description={pageDescription}>
  <main class="legal-page">
    <section class="legal-hero">
      <div class="container legal-hero__content">
        <p class="eyebrow">Legal</p>
        <h1>Privacy Policy</h1>
        <p class="legal-hero__intro">
          This Privacy Policy explains how QUAVAR Facility Services collects, uses,
          protects, and handles personal information in connection with our website,
          services, business communications, email, and text messaging.
        </p>
        <p class="legal-effective">Effective Date: October 5, 2026</p>
      </div>
    </section>

    <section class="legal-content section">
      <div class="container legal-content__grid">
        <aside class="legal-sidebar">
          <p class="legal-sidebar__label">QUAVAR Facility Services</p>
          <p>
            Restrepo Jaramillo Brothers Investment Group LLC<br />
            doing business as QUAVAR Facility Services
          </p>

          <p>
            4001 W Obispo St<br />
            Tampa, FL 33629<br />
            United States
          </p>

          <p>
            <a href="mailto:sales@quavarfs.com">sales@quavarfs.com</a>
          </p>
        </aside>

        <article class="legal-copy">
          <section>
            <h2>1. Introduction</h2>
            <p>
              Restrepo Jaramillo Brothers Investment Group LLC, doing business as
              QUAVAR Facility Services ("QUAVAR," "we," "us," or "our"), respects
              your privacy. This Privacy Policy describes how we collect, use,
              disclose, and protect personal information when you visit our website,
              communicate with us, request information or services, or otherwise
              interact with QUAVAR.
            </p>
          </section>

          <section>
            <h2>2. Information We Collect</h2>
            <p>
              We may collect information that you provide directly to us, including
              your name, company or organization, job title, email address, telephone
              number, facility information, service requirements, and the contents
              of communications you send to us.
            </p>

            <p>
              We may also collect certain information automatically when you use our
              website, such as browser type, device information, IP address,
              referring pages, pages visited, and information about how visitors
              interact with the website.
            </p>
          </section>

          <section>
            <h2>3. How We Use Information</h2>
            <p>We may use personal information to:</p>

            <ul>
              <li>Respond to inquiries and requests for information.</li>
              <li>Communicate about QUAVAR services, walkthroughs, proposals, and quotes.</li>
              <li>Provide and administer facility services.</li>
              <li>Maintain customer and prospect relationships.</li>
              <li>Schedule meetings, walkthroughs, or other business activities.</li>
              <li>Send operational, transactional, or authorized marketing communications.</li>
              <li>Improve our website, services, communications, and business operations.</li>
              <li>Maintain security, prevent misuse, and protect our legal rights.</li>
              <li>Comply with applicable legal and regulatory obligations.</li>
            </ul>
          </section>

          <section>
            <h2>4. Email Communications</h2>
            <p>
              QUAVAR may use email to respond to inquiries, communicate with
              prospects and customers, provide proposals or service information,
              and send other business communications.
            </p>

            <p>
              We may also send marketing or promotional email communications where
              permitted by applicable law. Recipients may opt out of promotional
              emails by using the unsubscribe mechanism provided in the message or
              by contacting us at
              <a href="mailto:sales@quavarfs.com">sales@quavarfs.com</a>.
            </p>

            <p>
              An opt-out from promotional email does not necessarily prevent QUAVAR
              from sending non-promotional communications relating to an existing
              business relationship, requested service, transaction, or other
              legitimate operational matter.
            </p>
          </section>

          <section>
            <h2>5. SMS and Text Messaging Privacy</h2>
            <p>
              QUAVAR may communicate by SMS or text message with individuals who
              have provided consent to receive such communications. Our SMS
              communications may include individual follow-up messages related to
              inquiries, facility cleaning services, walkthrough scheduling,
              proposals, quotes, and ongoing business communications.
            </p>

            <p>
              We do not sell or share your SMS opt-in data, consent, or mobile
              information with third parties or affiliates for their own marketing
              or promotional purposes.
            </p>

            <p>
              Text messaging originator opt-in data and consent will not be shared
              with third parties, except with aggregators and service providers
              necessary to enable and support the delivery of text messaging
              services.
            </p>

            <p>
              You may withdraw your consent to receive SMS messages at any time by
              replying <strong>STOP</strong>. For assistance, reply
              <strong>HELP</strong> or contact
              <a href="mailto:sales@quavarfs.com">sales@quavarfs.com</a>.
            </p>
          </section>

          <section>
            <h2>6. How We Share Information</h2>
            <p>
              We do not sell personal information. We may disclose personal
              information when reasonably necessary to operate our business,
              provide requested services, comply with legal obligations, or protect
              our rights.
            </p>

            <p>
              We may use trusted service providers that assist us with customer
              relationship management, communications, email delivery, website
              hosting, analytics, security, and other business operations. These
              providers may process information on our behalf as necessary to
              perform their services.
            </p>

            <p>
              We may also disclose information when required by law, legal process,
              or governmental request; in connection with a merger, acquisition,
              financing, reorganization, sale of assets, or similar business
              transaction; or when you direct or consent to the disclosure.
            </p>

            <p>
              Regardless of the foregoing, SMS opt-in data and consent are not sold
              or shared with third parties or affiliates for their own marketing or
              promotional purposes.
            </p>
          </section>

          <section>
            <h2>7. Website Analytics and Technologies</h2>
            <p>
              We may use cookies, analytics technologies, and similar tools to
              understand website usage, measure performance, improve user
              experience, maintain security, and evaluate the effectiveness of our
              communications and website.
            </p>

            <p>
              These technologies may collect technical and usage information such
              as device characteristics, browser information, IP address, pages
              visited, and interactions with website features.
            </p>
          </section>

          <section>
            <h2>8. Data Retention</h2>
            <p>
              We retain personal information for as long as reasonably necessary to
              fulfill the purposes for which it was collected, maintain legitimate
              business records, comply with legal obligations, resolve disputes,
              and enforce our agreements.
            </p>

            <p>
              We may retain records relating to communication consent, opt-outs,
              unsubscribe requests, and similar compliance matters when reasonably
              necessary to document and honor those preferences.
            </p>
          </section>

          <section>
            <h2>9. Data Security</h2>
            <p>
              We use reasonable administrative, technical, and organizational
              safeguards designed to protect personal information. However, no
              method of transmission over the Internet or electronic storage can be
              guaranteed to be completely secure.
            </p>
          </section>

          <section>
            <h2>10. Your Choices and Requests</h2>
            <p>
              Depending on the circumstances and applicable law, you may request
              information about personal data we maintain about you, ask us to
              correct inaccurate information, request deletion of certain
              information, or ask to stop receiving marketing communications.
            </p>

            <p>
              Requests may be sent to
              <a href="mailto:sales@quavarfs.com">sales@quavarfs.com</a>. Certain
              information may be retained where reasonably necessary or permitted
              by law, including for legal, security, recordkeeping, fraud
              prevention, contractual, or compliance purposes.
            </p>
          </section>

          <section>
            <h2>11. Third-Party Websites</h2>
            <p>
              Our website may contain links to third-party websites or services.
              QUAVAR is not responsible for the privacy practices, security, or
              content of third-party websites. We encourage users to review the
              privacy policies of those services before providing personal
              information.
            </p>
          </section>

          <section>
            <h2>12. Children's Privacy</h2>
            <p>
              QUAVAR's website and commercial facility services are not directed to
              children, and we do not knowingly seek to collect personal
              information from children through our website.
            </p>
          </section>

          <section>
            <h2>13. Changes to This Privacy Policy</h2>
            <p>
              We may update this Privacy Policy periodically to reflect changes in
              our practices, services, technology, or legal requirements. When we
              make changes, we may update the effective date shown at the top of
              this page.
            </p>
          </section>

          <section>
            <h2>14. Contact Us</h2>
            <p>
              Questions or requests concerning this Privacy Policy or QUAVAR's
              privacy practices may be directed to:
            </p>

            <address>
              <strong>QUAVAR Facility Services</strong><br />
              Restrepo Jaramillo Brothers Investment Group LLC<br />
              4001 W Obispo St<br />
              Tampa, FL 33629<br />
              United States<br />
              <a href="mailto:sales@quavarfs.com">sales@quavarfs.com</a>
            </address>
          </section>
        </article>
      </div>
    </section>
  </main>
</InteriorLayout>

<style>
  .legal-page {
    background: var(--color-white);
  }

  .legal-hero {
    padding: clamp(112px, 14vw, 168px) 0 clamp(72px, 9vw, 104px);
    background: var(--color-navy);
  }

  .legal-hero__content {
    max-width: 900px;
  }

  .legal-hero .eyebrow {
    color: var(--color-teal);
  }

  .legal-hero h1 {
    margin-top: 22px;
    color: var(--color-white);
  }

  .legal-hero__intro {
    max-width: 760px;
    margin-top: 28px;
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.65;
  }

  .legal-effective {
    margin-top: 30px;
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .legal-content__grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.32fr) minmax(0, 1fr);
    gap: clamp(48px, 8vw, 112px);
    align-items: start;
  }

  .legal-sidebar {
    position: sticky;
    top: 120px;
    padding: 32px;
    background: var(--color-off-white);
    border: 1px solid var(--color-border);
  }

  .legal-sidebar__label {
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .legal-sidebar p {
    margin: 0 0 22px;
    color: var(--color-slate);
    line-height: 1.65;
  }

  .legal-sidebar p:last-child {
    margin-bottom: 0;
  }

  .legal-sidebar a,
  .legal-copy a {
    color: var(--color-navy);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-copy {
    max-width: 820px;
  }

  .legal-copy section {
    padding-bottom: 42px;
    margin-bottom: 42px;
    border-bottom: 1px solid var(--color-border);
  }

  .legal-copy section:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: 0;
  }

  .legal-copy h2 {
    margin-bottom: 20px;
    color: var(--color-navy);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
  }

  .legal-copy p,
  .legal-copy li,
  .legal-copy address {
    color: var(--color-slate);
    font-size: 1rem;
    line-height: 1.8;
  }

  .legal-copy p {
    margin: 0 0 18px;
  }

  .legal-copy p:last-child {
    margin-bottom: 0;
  }

  .legal-copy ul {
    display: grid;
    gap: 10px;
    margin: 18px 0 0;
    padding-left: 24px;
  }

  .legal-copy address {
    margin-top: 20px;
    font-style: normal;
  }

  @media (max-width: 900px) {
    .legal-content__grid {
      grid-template-columns: 1fr;
    }

    .legal-sidebar {
      position: static;
      max-width: 520px;
    }
  }

  @media (max-width: 640px) {
    .legal-hero {
      padding: 96px 0 68px;
    }

    .legal-sidebar {
      padding: 26px;
    }

    .legal-copy section {
      padding-bottom: 34px;
      margin-bottom: 34px;
    }
  }
</style>